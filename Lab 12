travel(From, To, Path) :-
    travel(From, To, [From], ReversedPath),
    reverse(ReversedPath, Path).

travel(X, X, Path, Path).

travel(X, Y, Visited, Path) :-
    door(X, Z),
    \+ member(Z, Visited),
    travel(Z, Y, [Z|Visited], Path).
